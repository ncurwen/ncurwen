<footer id="site-footer"
        class="footer footer-horizontal items-center px-4 py-2 sm:px-6 sm:py-2.5 bg-base-200 border-t border-base-300 text-[clamp(0.7rem,2.8vw,0.8125rem)] leading-tight font-mono text-base-content/70">
  <aside class="grid-flow-col items-center gap-2 min-w-0">
    <span class="text-primary">$</span>
    <span class="whitespace-nowrap">echo "Copyright &copy; 1994&ndash;<%= Date.current.year %> Nick Curwen"</span>
  </aside>
  <nav class="grid-flow-col gap-4 justify-self-end">
    <%= tooltip_tag("My passion project plug ;)", position: 'left') do %>
      <a href="https://agilepanda.dev" target="_blank" rel="noopener" class="flex items-center gap-1.5 link link-hover">
        <%= image_tag "agile-panda.svg", alt: "AgilePanda logo", class: "w-5 h-5 shrink-0", loading: "lazy" %>
        <span class="max-[560px]:hidden">AgilePanda</span>
      </a>
    <% end %>
  </nav>
</footer>
