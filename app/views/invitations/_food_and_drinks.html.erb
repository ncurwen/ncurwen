<%# What to expect once you're there: the room, the bar, the food. The practical
    details (time, address, calendar) live in "Where & when" and nowhere else. %>
<section id="food-and-drinks" class="scroll-mt-8 pb-16">
  <h2 class="wedding-display mb-4 text-center text-3xl">Raise a glass at Paradigm</h2>
  <p class="mx-auto max-w-2xl text-center text-base-content/80">
    The party is at <a href="<%= Wedding::VENUE_URL %>" target="_blank" rel="noopener" class="link link-primary"><%= Wedding::VENUE %></a>,
    an award-winning craft distillery inside London&rsquo;s old Kellogg&rsquo;s cereal
    factory. Picture copper stills behind floor-to-ceiling windows, walls of whiskey
    barrels, and a covered patio looking out over the 100 Kellogg Lane courtyard.
  </p>
  <p class="mx-auto mt-4 max-w-2xl text-center text-base-content/80">
    The bar is open all night, dinner is a buffet, and late-night snacks keep
    coming until the lights come up.
  </p>

  <%# Cards are paired by height rather than by topic, two rows of a 2/3 + 1/3 split:

      1. Dinner beside the bar. Dinner flows its courses into two columns in menu
         order (phones read them top to bottom; desktop pairs Salads with Mains and
         Sides with Dessert). The bar stacks to one column in its narrow slot, which
         lands it at about dinner's height.
      2. The room photo beside late night. Late night is the shortest list on the
         page, so the photo takes up the slack: on desktop it grows into whatever
         height the row needs (h-0 + grow), with a floor so it never thins to a strip.

      Chronological too: dinner and drinks, then late night. %>
  <div class="mt-10 grid gap-6 lg:grid-cols-3">
    <article class="card bg-base-200 lg:col-span-2">
      <div class="card-body gap-5">
        <h3 class="card-title gap-2">
          <%= lucide_icon "utensils", class: "h-5 w-5 text-primary" %>
          Dinner buffet
        </h3>

        <div class="grid gap-x-8 sm:grid-cols-2">
          <% [
               { title: "Salads", icon: "salad", dishes: [
                   { name: "Fig & Burrata Salad with Crispy Prosciutto", tags: %w[GF],
                     description: "Black mission figs, torn burrata, crispy prosciutto, charred radicchio, endive, frisée, balsamic and toasted pine nut brittle with a Niagara Pinot Noir vinaigrette" },
                   { name: "Kale Caesar Salad",
                     description: "Heirloom baby kale, house smoked bacon, focaccia croutons, dried cranberries, roasted garlic Caesar dressing, Parmigiano Reggiano and lemon" }
                 ] },
               { title: "Mains", icon: "beef", dishes: [
                   { name: "Roasted Chicken", tags: %w[GF],
                     description: "Stuffed with house made herb butter, finished with sherry jus and chimichurri" },
                   { name: "Top Sirloin Roast", tags: %w[GF],
                     description: "Red wine peppercorn jus, prepared horseradish" },
                   { name: "Moroccan Cauliflower", tags: %w[VEG],
                     description: "Spiced cauliflower steaks topped with pomegranate chermoula, served with harissa hummus and North African couscous salad" }
                 ] },
               { title: "Sides", icon: "carrot", dishes: [
                   { name: "Potato Dauphinois", tags: %w[GF VEG], description: "Creamy potato gratin" },
                   { name: "Market Vegetables", description: "Whatever's in season" }
                 ] },
               { title: "Dessert", icon: "cake-slice", dishes: [
                   { name: "Assorted Dessert Display",
                     description: "Mini desserts, house baked pastries, macarons, brownies and chocolate covered strawberries" }
                 ] }
             ].each do |course| %>
            <section class="mb-6">
              <h4 class="mb-3 flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-primary">
                <%= lucide_icon course[:icon], class: "h-4 w-4 shrink-0" %>
                <%= course[:title] %>
              </h4>
              <ul class="space-y-3">
                <% course[:dishes].each do |dish| %>
                  <%= render "dish", **dish %>
                <% end %>
              </ul>
            </section>
          <% end %>
        </div>
      </div>
    </article>

    <article class="card bg-base-200">
      <div class="card-body gap-5">
        <h3 class="card-title gap-2">
          <%= lucide_icon "glass-water", class: "h-5 w-5 text-primary" %>
          On the bar, all night
        </h3>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
          <% [
               { icon: "beer", title: "Powerhouse Brewing Co.", note: "Brewed at 100 Kellogg Lane",
                 items: [ "IPA", "Cream Ale", "Light Lager", "Pilsner" ] },
               { icon: "citrus", title: "Paradigm coolers", note: "Made by our hosts",
                 items: [ "Lemonade Hibiscus", "Vodka Sour", "Whiskey Iced Tea" ] },
               { icon: "wine", title: "House wine",
                 items: [ "Red: Masi Valpolicella", "White: Te Henga Sauvignon Blanc" ] },
               { icon: "martini", title: "Mixed drinks",
                 items: [ "Standard bar rail" ] }
             ].each do |group| %>
            <section>
              <h4 class="flex items-center gap-2 font-semibold">
                <%= lucide_icon group[:icon], class: "h-4 w-4 shrink-0 text-primary" %>
                <%= group[:title] %>
              </h4>
              <% if group[:note] %>
                <p class="mt-0.5 text-xs italic text-base-content/60"><%= group[:note] %></p>
              <% end %>
              <ul class="mt-2 space-y-1 text-sm text-base-content/80">
                <% group[:items].each do |item| %>
                  <li><%= item %></li>
                <% end %>
              </ul>
            </section>
          <% end %>
        </div>
      </div>
    </article>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <figure class="card overflow-hidden bg-base-200 lg:col-span-2">
      <img src="<%= image_path("wedding/venue/paradigm-room.jpg") %>"
           alt="Paradigm's event room set for dinner under ring chandeliers" loading="lazy"
           class="aspect-[3/2] w-full object-cover lg:aspect-auto lg:h-0 lg:min-h-72 lg:grow">
      <figcaption class="p-4 text-sm text-base-content/70">
        The room: candlelit tables under ring chandeliers, with the bar along the back wall.
        <span class="text-base-content/50">Photo courtesy of 100 Kellogg Lane.</span>
      </figcaption>
    </figure>

    <article class="card bg-base-200">
      <div class="card-body gap-5">
        <h3 class="card-title gap-2">
          <%= lucide_icon "moon-star", class: "h-5 w-5 text-primary" %>
          Late night
        </h3>

        <ul class="space-y-4">
          <%= render "dish", name: "Taco Bar", tags: %w[GF* VEG*],
                     description: "Corn and flour tortillas with crispy breaded pollock, pork shoulder, chicken birria and battered cauliflower. Guacamole, house made salsas, pico de gallo, shredded lettuce and cheese. Go with the cauliflower for a vegetarian taco." %>
          <%= render "dish", name: "Korean BBQ Pork Belly Skewers", tags: %w[GF],
                     description: "Glazed, with sesame and scallion" %>
          <%= render "dish", name: "Crispy Tempura Vegetables", tags: %w[VEG GF],
                     description: "With Korean BBQ and spicy gochujang aioli" %>
        </ul>
      </div>
    </article>
  </div>

  <%# TODO: drop the "still being finalized" caveat once the caterer confirms the menu. %>
  <p class="mt-3 text-center text-xs text-base-content/50">
    The menu is still being finalized, so dishes may change.
    <%= safe_join(WeddingHelper::DIETARY_TAGS.map { |code, meaning| "#{code} #{meaning.downcase}" }, " · ") %>
    · * option available.
  </p>
</section>
