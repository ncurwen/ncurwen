<section>
  <h2 class="wedding-display mb-6 text-center text-3xl">Gifts</h2>
  <div class="card mx-auto max-w-2xl bg-base-200">
    <div class="card-body items-center text-center">
      <%# Grows on desktop, where this card sits beside the much taller
          "Where & when" column and would otherwise look stranded. %>
      <%= lucide_icon "gift", class: "h-12 w-12 text-primary lg:h-18 lg:w-18" %>
      <p class="text-lg">Your being there is the gift — please, no presents.</p>
      <p class="text-base-content/70">
        If you'd like to contribute to our honeymoon fund anyway, there'll be a
        card box at the party.
      </p>
    </div>
  </div>
</section>
